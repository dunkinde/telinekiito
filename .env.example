# Copy to .env (setup.sh does this for you and fills in the secrets).

# Public address. Use a domain once you have one, e.g. telinekiito.fi
SITE_ADDRESS=1-2-3-4.sslip.io
# "https" starts Caddy for HTTPS on ports 80/443. Leave empty to run without it.
COMPOSE_PROFILES=https
# Where the app listens on the host. 127.0.0.1:3000 behind Caddy, 0.0.0.0:8080 without it.
APP_BIND=127.0.0.1:3000

# Office login at /office (at least 8 characters).
OFFICE_PASSWORD=change-me-please
# Random string that signs the office login cookie.
SESSION_SECRET=

# Drawing reading with OpenAI. Leave the key empty to hide the upload box.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Most drawing readings per day across all visitors (protects your API credit).
AI_DAILY_LIMIT=40

# Add the three example orders on first start (set to 0 to start empty).
SEED_EXAMPLES=1
